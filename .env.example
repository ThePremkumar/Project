# CyberSentinel v3.0 Environment Variables

# Flask Secret Key (Random string)
ICTDS_SECRET_KEY=ictds-secret-2024-change-me

# SMTP Settings for Alerting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Geolocation (Optional)
MAXMIND_LICENSE_KEY=

# Redis (for Celery/WebSockets)
REDIS_URL=redis://redis:6379/0
